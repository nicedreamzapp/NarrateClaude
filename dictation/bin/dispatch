#!/bin/bash
# dispatch — long-running pipeline that runs the Swift listener and pastes
# each transcribed utterance into the bound Terminal window.
#
# Reads target window ID from state/target.json fresh on every utterance
# (via inject), so re-binding while running just works.
#
# To stop: `dictation stop` (or close the window — inject notices and bails).

set -uo pipefail

DICT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LISTEN_BIN="$DICT_DIR/bin/listen"
INJECT_BIN="$DICT_DIR/bin/inject"
TARGET_FILE="$DICT_DIR/state/target.json"
LOG_FILE="$DICT_DIR/state/dictation.log"
ERR_LOG="$DICT_DIR/state/dictation.log.stderr"
INJ_LOG="$DICT_DIR/state/dictation.log.inject"

# Voiceprint filter — only Matt's utterances make it past this stage.
# If the venv or voiceprint hasn't been built yet, dispatch falls back to
# a passthrough so the pipeline still works while the filter is set up.
FILTER_DIR="$DICT_DIR/filter"
FILTER_PY="$FILTER_DIR/filter.py"
FILTER_VENV="$FILTER_DIR/.venv/bin/python"
VOICEPRINT_FILE="$DICT_DIR/state/voiceprint.npy"
# When the watchdog notices the bound Terminal window is gone, it touches
# this flag instead of relying on signal delivery. The outer respawn loop
# checks the flag before each iteration and exits cleanly. Without this,
# the watchdog's `kill -TERM` race-loses to bash's deferred-signal handling
# on a blocked pipeline read, and the listener silently respawns into the
# void, transcribing the user's voice into a window that no longer exists.
SHUTDOWN_FLAG="$DICT_DIR/state/.shutdown"
rm -f "$SHUTDOWN_FLAG"

if [ ! -x "$LISTEN_BIN" ]; then
    echo "dispatch: listener not compiled at $LISTEN_BIN" >&2
    exit 1
fi
if [ ! -f "$TARGET_FILE" ]; then
    echo "dispatch: no target window bound (missing $TARGET_FILE)" >&2
    exit 1
fi

ts() { date "+%H:%M:%S"; }
echo "[$(ts)] dispatch starting" >> "$LOG_FILE"

# When this script exits for any reason, take the listener with us.
cleanup() {
    echo "[$(ts)] dispatch cleanup" >> "$LOG_FILE"
    rm -f "$SHUTDOWN_FLAG"
    pkill -P $$ 2>/dev/null || true
    exit 0
}
trap cleanup EXIT INT TERM

# Window watchdog: poll Terminal every 3s to confirm the bound window
# still exists. The moment it's gone, kill our own process group so the
# listener pipeline tears down. This is what enforces "listener only
# lives as long as the launcher's window does."
_request_shutdown() {
    # Touch the flag, kill the listener so the parent's pipeline drains,
    # and return. The outer respawn loop will see the flag and exit. We
    # deliberately do NOT `kill -TERM "$DISPATCH_PID"` here because bash
    # defers signal delivery while the parent is blocked on a pipeline
    # read, which made the old TERM-based approach race-lose.
    touch "$SHUTDOWN_FLAG"
    pkill -f "$LISTEN_BIN" 2>/dev/null || true
}

window_watchdog() {
    while true; do
        sleep 3
        if [ ! -f "$TARGET_FILE" ]; then
            echo "[$(ts)] watchdog: target file gone, requesting shutdown" >> "$LOG_FILE"
            _request_shutdown
            return
        fi
        local wid
        wid=$(/usr/bin/python3 -c "import json; print(json.load(open('$TARGET_FILE'))['window_id'])" 2>/dev/null)
        if [ -z "$wid" ]; then
            echo "[$(ts)] watchdog: no window_id in target file, requesting shutdown" >> "$LOG_FILE"
            _request_shutdown
            return
        fi
        local exists
        exists=$(/usr/bin/osascript <<OSA 2>/dev/null
tell application "Terminal"
    set found to "no"
    repeat with w in windows
        try
            if (id of w as text) is "$wid" then
                set found to "yes"
                exit repeat
            end if
        end try
    end repeat
    return found
end tell
OSA
)
        if [ "$exists" != "yes" ]; then
            echo "[$(ts)] watchdog: bound window $wid is gone, requesting shutdown" >> "$LOG_FILE"
            _request_shutdown
            return
        fi
    done
}

DISPATCH_PID=$$
window_watchdog &
WATCHDOG_PID=$!

# Main pipeline: stream listener stdout into per-line inject calls. Inject
# reads target.json fresh on every call so the binding can be re-pointed
# without restarting dispatch.
#
# Wrapped in a respawn loop so any listener exit (watchdog wedge detection
# at exit 99, preventive recycle at exit 0, crash at any other code) gets
# automatically replaced with a fresh process. The Swift listener is
# self-monitoring via its watchdog thread; if SFSpeechRecognizer hangs on
# a sync XPC call into the speech daemon, the watchdog notices the audio
# buffer backlog and bails, and we restart here.
respawn_count=0
while true; do
    if [ -f "$SHUTDOWN_FLAG" ]; then
        echo "[$(ts)] dispatch: shutdown requested by watchdog, exiting cleanly" >> "$LOG_FILE"
        rm -f "$SHUTDOWN_FLAG"
        exit 0
    fi
    respawn_count=$((respawn_count + 1))
    echo "[$(ts)] dispatch: starting listener (attempt $respawn_count)" >> "$LOG_FILE"
    start_epoch=$(date +%s)

    # If the filter venv + voiceprint are both ready, route the listener
    # through the python filter. Otherwise pass through unchanged so a
    # half-set-up filter never strands transcription.
    #
    # Force arm64 when invoking python: dispatch can end up running under
    # Rosetta (e.g. when its grandparent Terminal shell is x86_64), and a
    # translated bash spawns its universal-binary python children in x86_64
    # too. The filter's numpy/resemblyzer wheels are arm64-only, so without
    # `arch -arm64` the very first `import numpy` aborts with an arch
    # mismatch, the filter dies, and the listener crash-loops forever.
    if [ -x "$FILTER_VENV" ] && [ -f "$FILTER_PY" ] && [ -f "$VOICEPRINT_FILE" ]; then
        FILTER_CMD=(/usr/bin/arch -arm64 "$FILTER_VENV" "$FILTER_PY")
    else
        FILTER_CMD=(cat)
    fi

    # Stage 2: relevance filter — drops utterances that voiceprint passed
    # but clearly aren't aimed at the AI (talking to a human/animal/phone).
    # Uses system python — always available, no extra deps.
    RELEVANCE_PY="$FILTER_DIR/relevance.py"
    if [ -f "$RELEVANCE_PY" ]; then
        RELEVANCE_CMD=(/usr/bin/python3 "$RELEVANCE_PY")
    else
        RELEVANCE_CMD=(cat)
    fi

    "$LISTEN_BIN" 2>>"$ERR_LOG" | "${FILTER_CMD[@]}" 2>>"$ERR_LOG" | "${RELEVANCE_CMD[@]}" 2>>"$ERR_LOG" | while IFS= read -r line; do
        [ -z "$line" ] && continue
        printf "[%s] %s\n" "$(ts)" "$line" >> "$LOG_FILE"
        "$INJECT_BIN" "$line" >> "$INJ_LOG" 2>&1 || true
    done

    # Pipeline ended — listener exited for some reason.
    end_epoch=$(date +%s)
    lifetime=$((end_epoch - start_epoch))
    echo "[$(ts)] dispatch: listener exited after ${lifetime}s, respawning" >> "$LOG_FILE"

    # If the listener died almost immediately, something is fundamentally
    # broken (auth revoked, mic gone, binary missing). Back off harder so
    # we don't busy-loop and fill the log.
    if [ "$lifetime" -lt 3 ]; then
        sleep 5
    else
        sleep 1
    fi
done
